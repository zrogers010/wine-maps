# Google Analytics 4 Measurement ID
# Get this from your GA4 property settings (Admin > Data Streams > Web)
# If not set, analytics tracking will be disabled
# VITE_GA4_ID=G-XXXXXXXXXX

# Email capture provider
# If not set, the email signup card will not be shown (prevents discarding real signups)
# Set to 'stub' for development/testing (logs to console, always succeeds)
# Add real ESP integration and set to provider name (e.g., 'mailchimp', 'convertkit')
# VITE_EMAIL_PROVIDER=stub
